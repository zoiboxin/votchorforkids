{
  "name": "votechor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:server": "npm run dev -w @votechor/server",
    "dev:game": "npm run dev -w @votechor/game",
    "build": "npm run build -w @votechor/game",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "tsx": "^4.23.15",
    "@types/node": "^22.10.0"
  }
}
